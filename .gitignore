/target
**/*.rs.bk
*.profraw
/fuzz/target
# Cargo-fuzz writes generated inputs here. The seed corpus for the catalog
# parser is committed on purpose: it is a regression input, not a build output.
/fuzz/corpus/*
!/fuzz/corpus/fuzz_rule_toml/
/fuzz/artifacts
/fuzz/Cargo.lock

# Python bytecode from scripts/ probes.
__pycache__/

# makepkg output from `packaging/*/`, when a package is built in place.
# `sweep-*/` is the extracted or cloned source tree (`sweep-0.1.2`, `sweep-cli-git`).
/packaging/*/src
/packaging/*/pkg
/packaging/*/gen
/packaging/*/*.pkg.tar.*
/packaging/*/sweep-*/
